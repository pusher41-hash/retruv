# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — see .gitignore.

# --- Required ---

# PostgreSQL connection string (Neon in this project). NOTE: as currently
# configured on Vercel, this is the SAME value across Production, Preview,
# and Development — there is no separate dev/test database. Never point
# automated tests at this; use a local Postgres instead (see
# drizzle.test.config.json / .env.test / tests/integration/).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AES-256-GCM key for encrypting found-item private data (security.ts).
# Generate with: openssl rand -base64 32
RETRUV_ENC_KEY=""

# --- Optional but recommended in production ---

# Cloudflare Turnstile (anti-bot on register/declare past a request
# threshold). Without these, verifyTurnstileToken() fails OPEN in
# development and fails CLOSED in production — so production needs both set.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Canonical public URL, used to build absolute links in outbound
# notifications (e.g. the Slack "Ouvrir la file de modération" button).
# Falls back to https://retruv.vercel.app if unset.
NEXT_PUBLIC_APP_URL="https://retruv.vercel.app"

# Slack Incoming Webhook — pings a channel whenever a declaration lands in
# the moderation queue (see src/lib/moderation.ts). No-ops silently if unset.
RETRUV_MODERATION_WEBHOOK_URL=""

# Forwards every audit-log event to an external sink (SIEM, Datadog, a
# simple collector) as a second, harder-to-tamper-with copy alongside the
# DB row and the local audit-trail/ file. No-ops silently if unset.
RETRUV_AUDIT_WEBHOOK_URL=""

# Bearer secret Vercel Cron sends automatically to authorize the daily
# archive-expired-declarations job (see vercel.json). CRON_SECRET is
# Vercel's own reserved name and gets wired up with zero extra config once
# set here; RETRUV_CRON_SECRET is the same mechanism for any OTHER external
# scheduler (OS crontab, pg_cron, a different host).
CRON_SECRET=""
RETRUV_CRON_SECRET=""
